# ─── Python ───────────────────────────────────────────────
.env
.venv/
__pycache__/
*.pyc
*.egg-info/

# ─── Generated / cached artifacts ─────────────────────────
outputs/
coolspend/outputs/
coolspend/cache/          # large LiDAR/OSM/Infrared caches; regenerated on demand
.planning/spikes/*/audit_record.json

# ─── Node ─────────────────────────────────────────────────
node_modules/

# ─── Transient screenshots / Playwright captures ──────────
# Verification & debug screenshots are throwaway — never commit them.
*.png
*.jpeg
*.jpg
!video/public/**          # except real video assets
!web/public/**            # except real web assets
.playwright-mcp/
web/.playwright-mcp/
web/public/eval_bundle/   # per-request evaluation bundle (written at runtime)

# ─── Logs ─────────────────────────────────────────────────
*.log

# scratch dev artifacts at repo root (screenshots, ad-hoc logs)
/*.png
/*.jpeg
/*.jpg
/*.log

# nested duplicate project copy — never publish
hackathon_2/
# regenerable python-side caches (incl. a 166MB LiDAR .tif > GitHub 100MB limit)
coolspend/cache/
coolspend/outputs/
# duplicate of coolspend-explainer.mp4 (chooser uses that one)
web/public/coolspend-explainer-10min.mp4
video/out/coolspend-explainer-10min.mp4
