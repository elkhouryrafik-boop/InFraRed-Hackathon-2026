# ─── Python ───────────────────────────────────────────────
.env
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# ─── Generated / cached artifacts ─────────────────────────
outputs/
coolspend/outputs/
# large LiDAR/OSM/Infrared caches, regenerated on demand
coolspend/cache/
# runtime persistence: SQLite runs db + saved-run blobs
coolspend/var/
*.db
*.db-wal
*.db-shm
.planning/spikes/*/audit_record.json

# ─── Node ─────────────────────────────────────────────────
node_modules/
web/dist/
web/.vercel/
*.tsbuildinfo

# ─── Transient screenshots / Playwright captures ──────────
# verification and debug screenshots are throwaway
*.png
*.jpeg
*.jpg
# ...except real shipped assets
!video/public/**
!web/public/**
!docs/img/**
.playwright-mcp/
web/.playwright-mcp/
web/test-results/
# per-request evaluation bundle (written at runtime, never source)
web/public/eval_bundle/

# ─── Logs ─────────────────────────────────────────────────
*.log
/*.png
/*.jpeg
/*.jpg

# ─── Never publish ────────────────────────────────────────
# nested duplicate project copy
hackathon_2/
# duplicate of the explainer mp4 the chooser actually uses
web/public/coolspend-explainer-10min.mp4
video/out/coolspend-explainer-10min.mp4
