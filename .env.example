# CoolSpend — copy this to .env and fill what you need.
# Mock and cached backends need NO key at all: `INFRARED_BACKEND=mock` is enough
# to evaluate any drawn area offline.

# mock | cached | live  (server-side choice; a mock result is always labelled)
INFRARED_BACKEND=mock

# Only needed for INFRARED_BACKEND=live. Never commit a real key.
INFRARED_API_KEY=

# Optional: durable saved runs. SQLite is the local default when unset.
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Web client (put this in web/.env.local, not here):
# VITE_MAPBOX_TOKEN=      # basemap. Without it the app degrades, it does not crash.
# VITE_CESIUM_ION_TOKEN=  # optional photoreal 3D, disabled by default
