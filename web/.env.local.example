# ── CoolSpend web app tokens ────────────────────────────────────────────────
# Copy this file to `.env.local` (same directory) and fill in your tokens.
# `.env.local` is gitignored — never commit real tokens.
#
# The app DEGRADES GRACEFULLY:
#   - No Mapbox token  -> flat dark fallback map + all deck.gl overlays still render.
#   - No Cesium token  -> Mapbox basemap + overlays, but NO photorealistic 3D tiles.

# Mapbox GL access token (public, starts with "pk.").
# Get one free at: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Cesium Ion access token (starts with "eyJ").
# Get one free at: https://ion.cesium.com/tokens
# Used to proxy Google Photorealistic 3D Tiles (asset 2275207), EEA-friendly.
VITE_CESIUM_ION_TOKEN=
