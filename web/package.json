{
  "name": "coolspend-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Photorealistic 3D Barcelona visualization of urban-cooling simulation results (Infrared SDK + deck.gl + Cesium Ion Google 3D Tiles).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/extensions": "^9.1.0",
    "@deck.gl/geo-layers": "^9.1.0",
    "@deck.gl/layers": "^9.1.0",
    "@deck.gl/mapbox": "^9.1.0",
    "@deck.gl/react": "^9.1.0",
    "@loaders.gl/3d-tiles": "^4.3.0",
    "mapbox-gl": "^3.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^7.1.7"
  },
  "devDependencies": {
    "@types/mapbox-gl": "^3.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
